{
  "name": "@atelier-ui/react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Design system React, TypeScript et MUI avec Storybook",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsup",
    "prepack": "npm run build:lib",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "storybook:serve": "vite preview --outDir storybook-static --port 6006 --host 0.0.0.0 --strictPort",
    "test:a11y": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "pack:local": "node -e \"require('node:fs').mkdirSync('artifacts', {recursive:true})\" && npm pack --pack-destination artifacts"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "@mui/material": "^7.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.0",
    "@mui/icons-material": "^7.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "tsup": "^9.0.0",
    "prettier": "^3.6.0",
    "storybook": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/test": "8.6.14",
    "@playwright/test": "^1.65.0",
    "@axe-core/playwright": "^4.14.0"
  }
}
